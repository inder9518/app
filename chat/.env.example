# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# NEWS_API_KEY: Required for the News Bharat app.
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE

# GITHUB_TOKEN: Required for uploading chat photos and videos to GitHub.
# Configure this in the Secrets panel in AI Studio with your GitHub Personal Access Token.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_PLACEHOLDER

# GITHUB_REPO_OWNER: The username of the GitHub repository owner.
GITHUB_REPO_OWNER=YOUR_GITHUB_USERNAME_PLACEHOLDER

# GITHUB_REPO_NAME: The name of the GitHub repository where images/videos will be saved.
GITHUB_REPO_NAME=YOUR_GITHUB_REPO_NAME_PLACEHOLDER

# GITHUB_BRANCH: The target branch name (optional, defaults to main).
GITHUB_BRANCH=main

